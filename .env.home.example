# Copy to .env.home and fill from the Render dashboard.
# Do not commit .env.home.

POSTGRES_USER=cine3d
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=webxemphim

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
WATCH_ROOM_TOKEN_SECRET=replace-with-an-independent-32-character-secret

COOKIE_SECURE=true
NODE_ENV=production
CLIENT_URLS=https://cine3d.id.vn,https://www.cine3d.id.vn,https://cine3d.vercel.app
CANONICAL_WEB_URL=https://cine3d.id.vn
PUBLIC_API_URL=https://api.cine3d.id.vn/api
PASSWORD_RESET_URL=https://cine3d.id.vn/account
REQUIRE_EMAIL_VERIFICATION=true

# Optional: official TMDB API (use api.tmdb.org — api.themoviedb.org is often blocked).
TMDB_API_BASE=https://api.tmdb.org/3
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
VIP_PAYMENT_MODE=manual
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://cine3d.id.vn/vip?payment=success
PAYOS_CANCEL_URL=https://cine3d.id.vn/vip?payment=cancelled

BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM="CINE3D <no-reply@cine3d.id.vn>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_ANDROID_CLIENT_ID=
TURNSTILE_SECRET_KEY=
MOBILE_APP_ATTESTATION_TOKEN=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cine3d.id.vn

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin

POSTGRES_CACHE_ENABLED=false
ANALYTICS_RETENTION_DAYS=7

# APK CDN (default in code = GitHub Releases — free, no home bandwidth).
# Optional Cloudflare R2 (free tier 10GB; only bills if you add a card AND exceed free):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=cine3d-apk
# R2_PUBLIC_BASE=https://pub-xxxx.r2.dev
# NEXT_PUBLIC_ANDROID_APK_URL=https://pub-xxxx.r2.dev/cine3d.apk
# Then: node deploy/home/upload-apk-r2.js && rebuild frontend

# Facebook Page auto-post (Graph API — Page access token, not User token)
# FACEBOOK_PAGE_ID=1393081247217588
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_GRAPH_VERSION=v21.0
